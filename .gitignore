# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Data cache -- rebuildable, never committed
data/

# Secrets -- never commit; copy .env.template to .env and fill in
.env

# AI context -- private, tracked in the ai-context repo
AGENTS.md
CLAUDE.md

# VitePress docs build (node deps + rendered output; keep .vitepress/config.mts).
# The VitePress project lives in docs/, so the cache/output live under
# docs/.vitepress/ -- a root-anchored pattern misses them, so pin the real path.
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# ruff cache
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
