# Cambridge Open Data Portal (data.cambridgema.gov) credentials.
# Create an app token at https://data.cambridgema.gov/profile/edit/developer_settings
#
# App token: identifies this client to lift anonymous rate limits. Required
# for any non-trivial volume of pulls.
CAM_OPEN_DATA_APP_TOKEN_ID=
CAM_OPEN_DATA_APP_TOKEN_SECRET=

# API key: identifies an account via HTTP Basic auth. Only needed for
# private/unlisted assets or write access -- public dataset reads work with
# just the app token above.
CAM_OPEN_DATA_API_KEY_ID=
CAM_OPEN_DATA_API_KEY_SECRET=

# --- Storage (optional; defaults are repo-relative and need no .env) ---
# Where the local Parquet cache (catalog + raw pulls) lives. Defaults to the
# repo's data/ directory. Point it elsewhere -- a shared/centralised cache, or a
# user data dir when the package is installed rather than cloned -- by setting it.
# CAM_OPEN_DATA_CACHE_DIR=

# Where finished analysis reports live. Defaults to the repo's docs/reports/.
# CAM_OPEN_DATA_REPORTS_DIR=
